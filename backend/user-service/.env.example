# user-service environment variables
# Copy this file to .env and fill in values.

# Server
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/platoo_users

# JWT secret used for issuing auth tokens
JWT_SECRET=<FILL - e.g. long random string>

# Google OAuth (OIDC) - required for POST /api/auth/google with a Google ID token
GOOGLE_CLIENT_ID=<FILL - e.g. xxxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<FILL - google oauth client secret>

# Admin seed (node seed-admin.js) - optional. If ADMIN_PASSWORD is not set, a
# strong random password is generated and printed once. ADMIN_RESET_PASSWORD=1
# (or ADMIN_EMAIL) forces a rotation of an existing admin password.
ADMIN_EMAIL=<FILL - e.g. admin@platoo.com>
ADMIN_PASSWORD=<FILL - leave empty to generate a random one>
ADMIN_RESET_PASSWORD=