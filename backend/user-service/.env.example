# user-service environment variables
# Copy this file to .env and fill in values.

# Server
NODE_ENV=development
PORT=4000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/platoo_users

# JWT secret used for issuing auth tokens
JWT_SECRET=<FILL - e.g. long random string>

# Google OAuth (OIDC) - required for POST /api/auth/google with a Google ID token
GOOGLE_CLIENT_ID=<FILL - e.g. xxxxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<FILL - google oauth client secret>