NODE_ENV=development
PORT=3008
MONGO_URI=mongodb://localhost:27017/platoo_orders
MENU_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:8081
EMAIL_SERVICE=Gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PASS=
APP_NAME=platoo
# Must match JWT_SECRET in user-service/.env (used to verify user JWTs)
JWT_SECRET=
# Shared secret for trusted service-to-service calls (must match payment-service INTERNAL_SERVICE_KEY)
INTERNAL_SERVICE_KEY=
# Comma-separated list of allowed browser origins for the order API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Global rate limit (default 500 requests / 15 minutes)
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# Order-creation rate limit (default 30 requests / minute)
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_ORDER_WINDOW_MS=60000