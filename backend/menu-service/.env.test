# Test-only environment for the jest suites (menu-service).
# Points the service at a DEDICATED local test database, NEVER the dev (Atlas) platoo_menu.
# Guarded by tests/setup-env.js: refuses to run unless MONGO_URI database ends in "_test".
NODE_ENV=test
PORT=0
MONGO_URI=mongodb://127.0.0.1:27017/platoo_menu_test
TEST_MONGO_URI=mongodb://127.0.0.1:27017/platoo_menu_test
JWT_SECRET=test-only-jwt-secret-for-platoo-suites