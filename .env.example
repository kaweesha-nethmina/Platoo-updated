# =============================================================================
# PLATOO - FOOD ORDERING SYSTEM - MASTER ENV REFERENCE
# Copy this to each backend service's .env (see per-service comments below).
# Values marked <FILL> are secrets you must provide.
# =============================================================================

# ---- Shared / Common ----
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/platoo_<service-name>
JWT_SECRET=<FILL - e.g. long random string>

# ---- Email (Gmail app password) ----
EMAIL_SERVICE=Gmail
EMAIL_USER=<FILL - sender gmail address>
EMAIL_PASS=<FILL - gmail app password>
EMAIL_PASSWORD=<FILL - gmail app password>
APP_NAME=Platoo

# ---- Third-party keys ----
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>
GOOGLE_MAPS_API_KEY=<FILL>
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- Inter-service URL (used on special hosts) ----
MENU_SERVICE_URL=http://localhost:3001
CLIENT_URL=http://localhost:8000

# =============================================================================
# RUNNING LOCALLY (each service dir):
#   backend/user-service/.env          PORT=4000          MONGO_URI, JWT_SECRET
#   backend/menu-service/.env          PORT=3001          MONGO_URI
#   backend/search-service/.env        PORT=3002          MONGO_URI
#   backend/delevery-service/.env      PORT=3003          MONGO_URI
#   backend/cart-service/.env          PORT=3005          MONGO_URI
#   backend/geo-location-service/.env  PORT=3007          MONGODB_URI, GOOGLE_MAPS_API_KEY, CLIENT_URL
#   backend/order-service/.env         PORT=3008          MONGO_URI, EMAIL_USER, EMAIL_PASS, MENU_SERVICE_URL
#   backend/ratings-service/.env       PORT=5000          MONGO_URI, REDIS_HOST, REDIS_PORT
#   backend/admin-service/.env         PORT=4005          EMAIL_USER, EMAIL_PASSWORD, EMAIL_SERVICE, APP_NAME
#   backend/notification-service/.env  PORT=4006          MONGO_URI, EMAIL_USER, EMAIL_PASS
#   backend/payment-service/.env       (Spring - export env vars) STRIPE_SECRET_KEY, SERVER_PORT
# Frontend runs on http://localhost:8000 (hardcoded service URLs).
# =============================================================================